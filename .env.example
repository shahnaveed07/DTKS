# DreamTech Kashmir Solutions (DTKS) — Frontend Environment Variables
# Copy to .env (local) or configure in Cloudflare Pages / Workers Build Environment Variables.
# IMPORTANT: Vite embeds VITE_* variables into the bundle AT BUILD TIME.
# Changing .env.example alone does NOT affect Cloudflare builds — you must configure these
# in your Cloudflare project settings and trigger a fresh deployment.
# Never store backend secrets, database credentials, or private tokens here.

# Adapter mode: 'api' (required for production/live DTKS_BE) or 'local' (offline local dev preview only)
# Production builds without VITE_DATA_ADAPTER=api / VITE_API_BASE_URL block Admin access for security.
# Note: VITE_ENABLE_LOCAL_ADMIN cannot bypass production security restrictions.
VITE_DATA_ADAPTER=api

# Official DTKS_BE API base URL (must use HTTPS in production; localhost is rejected in prod)
VITE_API_BASE_URL=https://api.dreamtechkashmirsolutions.studio/api/v1

# Official production site URL used for canonical tags, OpenGraph URLs, sitemap, and robots.txt
VITE_SITE_URL=https://dreamtechkashmirsolutions.studio

# Optional Search Console site verification tokens
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=