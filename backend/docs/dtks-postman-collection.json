{
  "info": {
    "name": "DTKS – DreamTech Kashmir Solutions Backend API",
    "_postman_id": "2a793036-53a0-4c00-bef9-9f0a0bb2fefd",
    "description": "Complete Postman Collection for the DTKS Cloudflare Workers + D1 + R2 REST API (/api/v1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "replace-with-your-admin-password",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dreamtechkashmirsolutions.studio\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Get Current Admin (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Rotate Refresh Token (/auth/refresh)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Change Admin Password (/auth/change-password)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"NewSecureAdmin@2026!\"\n}"
            }
          }
        },
        {
          "name": "Admin Logout (/auth/logout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Services",
      "item": [
        {
          "name": "List Active Services",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/services"
          }
        },
        {
          "name": "Get Service by Slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/services/business-corporate-websites"
          }
        },
        {
          "name": "Create Service (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/services",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Custom Web Portals & Dashboards\",\n  \"slug\": \"custom-web-portals-dashboards\",\n  \"description\": \"End-to-end architecture and responsive development for custom web portals.\",\n  \"features\": [\"Role-based access\", \"Fast search & reporting\"],\n  \"price\": 38000,\n  \"is_active\": true,\n  \"display_order\": 11\n}"
            }
          }
        },
        {
          "name": "Update Service (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/services/svc-business-websites",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 16000,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Delete Service (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/services/custom-web-portals-dashboards"
          }
        }
      ]
    },
    {
      "name": "3. Packages",
      "item": [
        {
          "name": "List Packages",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/packages?service_id=svc-business-websites"
          }
        },
        {
          "name": "Get Package by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/packages/pkg-business-website"
          }
        },
        {
          "name": "Create Package (Admin)",
          "request": {
            "method": "POST",
