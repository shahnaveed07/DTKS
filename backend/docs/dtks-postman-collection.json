            "url": "{{baseUrl}}/packages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Enterprise Corporate Website Package\",\n  \"service_id\": \"svc-business-websites\",\n  \"description\": \"Comprehensive multi-department corporate website package.\",\n  \"price\": 45000,\n  \"features\": [\"Custom design system\", \"Technical SEO\"],\n  \"is_active\": true,\n  \"display_order\": 10\n}"
            }
          }
        }
      ]
    },
    {
