{
  "name": "dtks-backend-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + D1 + R2 Backend API for DreamTech Kashmir Solutions (DTKS)",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
